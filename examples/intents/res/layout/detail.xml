<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
  <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="24sp" />
  <Button android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Finish" android:onClick="done" />
  <Button android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Finish home" android:onClick="finishHome" />
</LinearLayout>
