<resources>
    <item name="sample_alias" type="drawable">@drawable/sample</item>
    <style name="ProbeTextBase"><item name="android:textSize">20sp</item></style>
    <style name="ProbeText" parent="ProbeTextBase"><item name="android:textColor">#202a36</item></style>
    <attr name="testPalette" format="color|reference" />
    <attr name="testPaletteAlias" format="color|reference" />
    <color name="style_palette_alias">@color/style_states</color>
    <style name="PaletteTheme">
        <item name="testPalette">@color/style_palette_alias</item>
        <item name="testPaletteAlias">?attr/testPalette</item>
    </style>
    <style name="PaletteAlternate"><item name="testPalette">#778899</item></style>
    <style name="DialogHostTheme"><item name="android:dialogTheme">@style/PaletteAlternate</item></style>
    <style name="PaletteCycle">
        <item name="testPalette">?attr/testPaletteAlias</item>
        <item name="testPaletteAlias">?attr/testPalette</item>
    </style>
    <style name="InlineText"><item name="android:textColor">#202a36</item></style>
    <style name="ThemeText"><item name="android:textColor">?attr/testPaletteAlias</item><item name="android:textSize">19.5sp</item></style>
    <style name="NullText"><item name="android:textColor">@null</item></style>
    <style name="SizeOnlyText"><item name="android:textSize">23sp</item></style>
    <color name="framework_white_alias">@android:color/white</color>
    <style name="FrameworkColors">
        <item name="android:textColor">@color/framework_white_alias</item>
        <item name="android:textColorHighlight">@android:color/black</item>
        <item name="android:textColorHint">@android:color/transparent</item>
    </style>
    <attr name="defaultWidgetStyle" format="reference" />
    <attr name="defaultWidgetAlias" format="reference" />
    <style name="DefaultsTheme">
        <item name="defaultWidgetStyle">@style/DefaultsSelected</item>
        <item name="defaultWidgetAlias">?attr/defaultWidgetStyle</item>
        <item name="android:label">Theme value</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#ff101010</item>
    </style>
    <style name="DefaultsMissing"><item name="android:textSize">13sp</item></style>
    <style name="DefaultsNull" parent="DefaultsTheme"><item name="defaultWidgetStyle">@null</item></style>
    <style name="DefaultsCycle" parent="DefaultsTheme">
        <item name="defaultWidgetStyle">?attr/defaultWidgetAlias</item>
    </style>
    <style name="DefaultsFallback">
        <item name="android:label">Fallback</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">#ff202020</item>
        <item name="android:layout">@layout/main</item>
    </style>
    <style name="DefaultsSelected">
        <item name="android:label">Selected</item>
        <item name="android:textColor">#ff303030</item>
        <item name="android:layout">@layout/factory_leaf</item>
    </style>
    <style name="DefaultsXml">
        <item name="android:label">XML style</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">#ff404040</item>
        <item name="android:layout">@layout/factory_include</item>
    </style>
    <attr name="srcCompat" format="reference" />
</resources>
