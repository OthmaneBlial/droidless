<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
  <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" />
  <ImageView android:id="@+id/source" android:layout_width="160dp" android:layout_height="100dp" android:src="@drawable/sample" android:contentDescription="Packaged PNG source" />
  <ImageView android:id="@+id/png" android:layout_width="160dp" android:layout_height="100dp" />
  <ImageView android:id="@+id/jpeg" android:layout_width="160dp" android:layout_height="100dp" />
  <ImageView android:id="@+id/webp" android:layout_width="160dp" android:layout_height="100dp" />
</LinearLayout>
